---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '../styles/tokens.css';
import '../styles/global.css';

// The two most-used faces, preloaded so text renders in its final font sooner.
import monoMedium from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';
import sansRegular from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';

import siteConfig from '../../site.config';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${siteConfig.name} — ${siteConfig.role}`,
  description = siteConfig.description,
  noindex = false,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og.png'), Astro.site);

// Analytics only in the deployed build (or when forced), never in dev or a local preview.
const goatcounterCode: string = siteConfig.goatcounterCode;
const analytics =
  import.meta.env.PROD &&
  goatcounterCode !== '' &&
  (process.env.GITHUB_ACTIONS === 'true' || process.env.FORCE_ANALYTICS === 'true');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before first paint: apply a saved theme choice so there is no flash.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <meta name="theme-color" content="#F7F9FB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0F14" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preload" href={monoMedium} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansRegular} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      analytics && (
        <script
          is:inline
          async
          data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
