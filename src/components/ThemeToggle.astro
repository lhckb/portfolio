<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme">
  <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
  <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const chrome = { light: '#F7F9FB', dark: '#0B0F14' };

  type Theme = 'light' | 'dark';
  const current = (): Theme =>
    root.dataset.theme === 'light' || root.dataset.theme === 'dark'
      ? root.dataset.theme
      : systemDark.matches
        ? 'dark'
        : 'light';

  function sync() {
    const theme = current();
    button?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
    // Once the visitor has picked a theme, the browser chrome follows it, not the system.
    if (root.dataset.theme) {
      document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.setAttribute('content', chrome[theme]));
    }
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Storage blocked: the choice lasts until the page is closed.
    }
    sync();
  }

  button?.addEventListener('click', () => {
    const next: Theme = current() === 'dark' ? 'light' : 'dark';
    // Crossfade between themes where supported; otherwise, or with reduced motion, switch instantly.
    if ('startViewTransition' in document && !reducedMotion.matches) {
      document.startViewTransition(() => apply(next));
    } else {
      apply(next);
    }
  });
  systemDark.addEventListener('change', sync);
  sync();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: 4px;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
    background: var(--surface-hover);
  }

  /* Without JavaScript the toggle can't work, so keep its space but hide it. */
  :global(:root:not(.js)) .theme-toggle {
    visibility: hidden;
  }

  /* Theme switch crossfade (see the click handler). */
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation-duration: 300ms;
    animation-timing-function: ease;
  }

  /* The icon shows the theme a click switches to. */
  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }
</style>
