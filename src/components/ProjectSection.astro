---
import type { Project, Section } from '../lib/types';
import ProjectRow from './ProjectRow.astro';

interface Props {
  id: Section;
  title: string;
  subtitle: string;
  command: string;
  projects: Project[];
}

const { id, title, subtitle, command, projects } = Astro.props;
const accent = id === 'software' ? 'var(--accent-software)' : 'var(--accent)';
const count = `${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`;
---

<section id={id} class="section" aria-labelledby={`${id}-heading`} style={`--section-accent: ${accent}`}>
  <div class="container inner">
    <p class="prompt"><span class="sigil">$</span> {command}</p>
    <div class="head">
      <div>
        <h2 id={`${id}-heading`}>{title}</h2>
        <p class="subtitle">{subtitle} · {count}</p>
      </div>
      <slot name="actions" />
    </div>
    <div class="panel">
      <div class="columns" aria-hidden="true">
        <span class="col-name">name</span>
        <span class="col-desc">description</span>
        <span class="col-meta"><span class="col-lang">lang</span><span class="col-updated">updated</span></span>
      </div>
      <ul role="list">
        {projects.map((project) => <ProjectRow project={project} />)}
      </ul>
    </div>
  </div>
</section>

<style>
  .section {
    border-top: 1px solid var(--border);
  }

  .inner {
    padding-block: var(--section-pad);
  }

  .sigil {
    color: var(--section-accent);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin: 16px 0 28px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 34px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .subtitle {
    margin: 8px 0 0;
    font-size: 16px;
    color: var(--text-3);
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  /* Visual column headers; rows carry their own hidden labels. Widths match ProjectRow. */
  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    padding: 12px 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .col-name {
    flex: 1 1 240px;
  }

  .col-desc {
    flex: 2 1 320px;
  }

  .col-meta {
    flex: 0 0 auto;
    display: flex;
    gap: 20px;
  }

  .col-lang {
    width: 96px;
  }

  .col-updated {
    width: 80px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 639px) {
    /* Columns stack on phones, so the header row would only mislead. */
    .columns {
      display: none;
    }

    .panel :global(.row:first-child) {
      border-top: 0;
    }
  }
</style>
