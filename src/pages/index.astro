---
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectSection from '../components/ProjectSection.astro';
import { getProjects } from '../lib/github';

const { software, data } = await getProjects();
const syncedAt = new Date();

const firstSection = software.length > 0 ? 'software' : data.length > 0 ? 'data' : undefined;
// The filter only helps when both kinds of data project are listed.
const showFilter = data.some((p) => p.sub === 'ds') && data.some((p) => p.sub === 'de');
---

<Base>
  {firstSection && <a class="skip-link" href={`#${firstSection}`}>Skip to projects</a>}
  <Header showSoftware={software.length > 0} showData={data.length > 0} />
  <main>
    <Hero syncedAt={syncedAt} />
    {
      software.length > 0 && (
        <ProjectSection
          id="software"
          title="Software Engineering"
          subtitle="Applications, services and tools"
          command="ls ~/projects/software --sort=updated"
          projects={software}
        />
      )
    }
    {
      data.length > 0 && (
        <ProjectSection
          id="data"
          title="Data"
          subtitle="Data science and data engineering"
          command="ls ~/projects/data --sort=updated"
          projects={data}
        >
          {showFilter && <FilterBar slot="actions" />}
        </ProjectSection>
      )
    }
  </main>
  <Footer syncedAt={syncedAt} />
</Base>
